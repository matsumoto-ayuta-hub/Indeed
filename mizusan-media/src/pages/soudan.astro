---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";

const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/soudan`,
  name: "水産キャリア 無料相談",
  description:
    "水産業界専門の転職・就職相談。水産加工・養殖・漁師・水産営業への転職を無料サポート。",
  url: `${siteUrl}/soudan`,
  telephone: "",
  areaServed: "JP",
  serviceType: "有料職業紹介",
};
---

<BaseLayout
  title="無料キャリア相談｜水産業界の転職・就職をプロがサポート"
  description="水産業界への転職・就職を専門コンサルタントが無料サポート。水産加工・養殖・漁師・水産営業。秘密厳守・完全無料でご相談いただけます。"
  ogType="website"
  jsonLd={localBusinessLd}
>
  <Breadcrumb
    items={[{ label: "ホーム", href: "/" }, { label: "無料キャリア相談" }]}
  />

  <!-- Hero -->
  <section
    style="background:linear-gradient(135deg,#0a5c8f 0%,#1a7ab8 100%); color:#fff; padding:4rem 0; text-align:center;"
  >
    <div class="container">
      <p
        style="font-size:0.9rem; opacity:0.8; margin-bottom:0.5rem; letter-spacing:0.05em;"
      >
        完全無料・秘密厳守
      </p>
      <h1 style="font-size:clamp(1.6rem,4vw,2.4rem); margin-bottom:1rem;">
        水産業界への転職<br />まず相談してみませんか？
      </h1>
      <p style="opacity:0.9; max-width:560px; margin:0 auto 2rem; font-size:1.05rem;">
        専門コンサルタントが、水産加工・養殖・漁師・水産営業への転職を無料でサポートします。
      </p>
      <a
        href="#form"
        style="display:inline-block; background:#e8a020; color:#fff; font-weight:700; padding:1rem 2.5rem; border-radius:8px; text-decoration:none; font-size:1.1rem;"
      >
        無料相談フォームへ →
      </a>
    </div>
  </section>

  <div class="container--narrow" style="padding-top:3rem; padding-bottom:4rem;">
    <!-- 特徴 -->
    <section style="margin-bottom:3rem;">
      <h2
        style="font-size:1.4rem; text-align:center; margin-bottom:2rem; color:var(--color-primary-dark);"
      >
        水産キャリアが選ばれる理由
      </h2>
      <div
        style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1.25rem;"
      >
        {
          [
            {
              icon: "🎯",
              title: "水産業界に特化",
              body: "水産加工・養殖・漁師・水産営業の求人を専門に扱うエージェントです。",
            },
            {
              icon: "💰",
              title: "完全無料",
              body: "求職者様への費用は一切かかりません。企業側からの紹介手数料で運営しています。",
            },
            {
              icon: "🔒",
              title: "秘密厳守",
              body: "現職への連絡・情報漏洩は絶対にしません。安心してご相談ください。",
            },
            {
              icon: "🤝",
              title: "内定まで伴走",
              body: "書類作成・面接対策・条件交渉まで専任コンサルタントがサポートします。",
            },
          ].map(({ icon, title, body }) => (
            <div
              style="background:var(--color-bg-alt); border-radius:10px; padding:1.5rem; text-align:center;"
            >
              <div style="font-size:2.5rem; margin-bottom:0.75rem;">{icon}</div>
              <h3 style="font-size:1rem; font-weight:700; margin-bottom:0.5rem;">
                {title}
              </h3>
              <p style="font-size:0.875rem; color:var(--color-text-muted);">
                {body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 相談の流れ -->
    <section style="margin-bottom:3rem;">
      <h2
        style="font-size:1.4rem; margin-bottom:1.5rem; padding-left:0.75rem; border-left:4px solid var(--color-primary); color:var(--color-primary-dark);"
      >
        相談の流れ
      </h2>
      <ol style="list-style:none; display:flex; flex-direction:column; gap:1rem;">
        {
          [
            {
              step: 1,
              title: "フォームorLINEで相談申込",
              body: "お名前・ご希望職種・簡単な経歴を入力するだけ。1分で完了します。",
            },
            {
              step: 2,
              title: "担当コンサルタントからご連絡",
              body: "1営業日以内にメール/電話でご連絡します。ご都合のよい面談日時を調整します。",
            },
            {
              step: 3,
              title: "無料キャリア面談（オンライン可）",
              body: "現状とご希望をヒアリングし、最適な求人・転職戦略をご提案します。",
            },
            {
              step: 4,
              title: "求人紹介・応募書類作成サポート",
              body: "非公開求人を含む最適な求人をご紹介。履歴書・職務経歴書の添削も無料です。",
            },
            {
              step: 5,
              title: "内定・入社",
              body: "条件交渉・入社日調整もサポート。内定後も安心してご相談いただけます。",
            },
          ].map(({ step, title, body }) => (
            <li
              style="display:flex; gap:1rem; align-items:flex-start; padding:1.25rem; border:1px solid var(--color-border); border-radius:8px;"
            >
              <span
                style="width:2rem; height:2rem; border-radius:50%; background:var(--color-primary); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; flex-shrink:0; font-size:0.9rem;"
              >
                {step}
              </span>
              <div>
                <strong style="display:block; margin-bottom:0.25rem;">{title}</strong>
                <span style="font-size:0.875rem; color:var(--color-text-muted);">
                  {body}
                </span>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- フォームプレースホルダー -->
    <section id="form" style="margin-bottom:3rem;">
      <h2
        style="font-size:1.4rem; margin-bottom:1.5rem; padding-left:0.75rem; border-left:4px solid var(--color-primary); color:var(--color-primary-dark);"
      >
        無料相談フォーム
      </h2>
      <div
        style="background:var(--color-bg-alt); border:2px dashed var(--color-border); border-radius:10px; padding:2.5rem; text-align:center;"
      >
        <p style="color:var(--color-text-muted); margin-bottom:1rem;">
          ここにフォームサービス（例: Formrun / Typeform）の埋め込みコードを設置します。<br />
          個人情報の取り扱い・送信先・プライバシーポリシーは担当者が設計・承認のうえ接続してください。
        </p>
        <p style="font-size:0.875rem; color:var(--color-text-muted);">
          ⚠️ 認証情報・APIキーはコードに直書きせず、環境変数で管理してください。
        </p>
      </div>
    </section>

    <!-- プライバシーポリシーへのリンク -->
    <p style="font-size:0.875rem; color:var(--color-text-muted); text-align:center;">
      ご入力いただいた個人情報は、<a href="/privacy">プライバシーポリシー</a
      >に基づき適切に管理します。
    </p>
  </div>
</BaseLayout>
