---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Cta from "../../components/Cta.astro";

const clusters = ["suisankako", "yoshoku", "ryoshi", "eigyo"] as const;
type Cluster = (typeof clusters)[number];

export async function getStaticPaths() {
  const clusterIds = ["suisankako", "yoshoku", "ryoshi", "eigyo"] as const;
  return clusterIds.map((cluster) => ({ params: { cluster } }));
}

const { cluster } = Astro.params as { cluster: Cluster };

const clusterMeta: Record<
  Cluster,
  { label: string; description: string; emoji: string }
> = {
  suisankako: {
    label: "水産加工",
    description:
      "水産加工場・水産加工会社への転職・就職情報。未経験歓迎の求人から年収・きつさのリアルまで徹底解説。",
    emoji: "🏭",
  },
  yoshoku: {
    label: "養殖",
    description:
      "養殖業への転職・就業支援情報。ブリ・マグロ・牡蠣などの魚種別求人・移住支援まで。",
    emoji: "🐠",
  },
  ryoshi: {
    label: "漁師",
    description:
      "漁師になる方法・漁業就業支援センター情報。未経験から漁師へのキャリアチェンジを完全サポート。",
    emoji: "⚓",
  },
  eigyo: {
    label: "水産営業",
    description:
      "水産商社・食品メーカー・仲卸業者の営業職転職情報。年収・キャリアパス・面接対策まで。",
    emoji: "💼",
  },
};

const meta = clusterMeta[cluster];

const articles = await getCollection(
  "articles",
  (a) => !a.data.draft && a.data.cluster === cluster
);
const sorted = articles.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const pillars = sorted.filter((a) => a.data.isPillar);
const clusters_articles = sorted.filter((a) => !a.data.isPillar);
---

<BaseLayout
  title={`${meta.label}の転職・就職情報｜水産キャリア`}
  description={meta.description}
>
  <Breadcrumb
    items={[{ label: "ホーム", href: "/" }, { label: meta.label }]}
  />

  <section
    style="background:linear-gradient(135deg,#0a5c8f 0%,#1a7ab8 100%); color:#fff; padding:3rem 0; text-align:center;"
  >
    <div class="container">
      <div style="font-size:3rem; margin-bottom:0.5rem;">{meta.emoji}</div>
      <h1 style="font-size:clamp(1.4rem,3.5vw,2rem); margin-bottom:0.75rem;">
        {meta.label}の転職・就職情報
      </h1>
      <p style="opacity:0.9; max-width:560px; margin:0 auto;">{meta.description}</p>
    </div>
  </section>

  <div class="container" style="padding-top:3rem; padding-bottom:3rem;">
    {
      pillars.length > 0 && (
        <section style="margin-bottom:3rem;">
          <h2 style="font-size:1.3rem; margin-bottom:1.25rem; padding-left:0.75rem; border-left:4px solid var(--color-primary);">
            完全ガイド
          </h2>
          <div class="card-grid">
            {pillars.map((a) => (
              <div class="card">
                <div class="card__body">
                  <h3 class="card__title">
                    <a href={`/articles/${a.id}`}>{a.data.title}</a>
                  </h3>
                  <p
                    style="font-size:0.875rem; color:var(--color-text-muted); margin-top:0.5rem;"
                  >
                    {a.data.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      clusters_articles.length > 0 && (
        <section>
          <h2 style="font-size:1.3rem; margin-bottom:1.25rem; padding-left:0.75rem; border-left:4px solid var(--color-accent);">
            記事一覧（{clusters_articles.length}件）
          </h2>
          <div class="card-grid">
            {clusters_articles.map((a) => (
              <div class="card">
                <div class="card__body">
                  <h3 class="card__title">
                    <a href={`/articles/${a.id}`}>{a.data.title}</a>
                  </h3>
                  <p class="card__date">
                    {a.data.pubDate.toLocaleDateString("ja-JP")}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      sorted.length === 0 && (
        <p style="color:var(--color-text-muted); text-align:center; padding:3rem 0;">
          記事を準備中です。しばらくお待ちください。
        </p>
      )
    }

    <Cta />
  </div>
</BaseLayout>
