# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Application
APP_BASE_URL=https://your-domain.com
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret

# Database
DATABASE_URL=sqlite:///./data/indeed_jobs.db

# 有料職業紹介事業許可番号
AGENCY_LICENSE_NUMBER=13-ユ-XXXXXX
AGENCY_NAME=株式会社キャリアジャパン

# Account 1: 自社採用 + 提携先一部掲載
ACCOUNT1_ID=account_self
ACCOUNT1_EMAIL=account1@example.com
ACCOUNT1_PUBLISHER_NAME=株式会社キャリアジャパン自社採用

# Account 2: インターン・小規模
ACCOUNT2_ID=account_intern
ACCOUNT2_EMAIL=account2@example.com
ACCOUNT2_PUBLISHER_NAME=キャリアジャパンインターン採用

# Account 3: 提携先専用（大規模掲載）
ACCOUNT3_ID=account_partner
ACCOUNT3_EMAIL=account3@example.com
ACCOUNT3_PUBLISHER_NAME=キャリアジャパンパートナー採用

# Feed settings
FEED_REFRESH_INTERVAL_HOURS=6
JOB_EXPIRY_DAYS=30
AUTO_RENEW_DAYS_BEFORE_EXPIRY=5
