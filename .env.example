# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Application
APP_BASE_URL=https://your-domain.com
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret

# Database
DATABASE_URL=sqlite:///./data/indeed_jobs.db

# 有料職業紹介事業許可番号・代理店情報
AGENCY_LICENSE_NUMBER=13-ユ-318960
AGENCY_NAME=株式会社キャリアジャパン

# ── Indeed Partner Console 認証情報 ───────────────────────────────────────────
# https://partners.indeed.com/ から取得した OAuth2 クレデンシャル（アカウントごと）
#
# アカウント1: 自社採用 + 提携先一部掲載
ACCOUNT_SELF_CLIENT_ID=
ACCOUNT_SELF_CLIENT_SECRET=
ACCOUNT_SELF_PUBLISHER_NAME=株式会社キャリアジャパン自社採用
#
# アカウント2: インターン・小規模採用
ACCOUNT_INTERN_CLIENT_ID=
ACCOUNT_INTERN_CLIENT_SECRET=
ACCOUNT_INTERN_PUBLISHER_NAME=キャリアジャパンインターン採用
#
# アカウント3: 提携先専用（大規模掲載）
ACCOUNT_PARTNER_CLIENT_ID=
ACCOUNT_PARTNER_CLIENT_SECRET=
ACCOUNT_PARTNER_PUBLISHER_NAME=キャリアジャパンパートナー採用

# Indeed API 設定
INDEED_TOKEN_URL=https://apis.indeed.com/oauth/v2/tokens
INDEED_GRAPHQL_URL=https://apis.indeed.com/graphql

# 求人管理設定
JOB_EXPIRY_DAYS=30
AUTO_RENEW_DAYS_BEFORE_EXPIRY=5
SYNC_INTERVAL_HOURS=6
